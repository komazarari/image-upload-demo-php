# Image Upload Demo - Environment Configuration

# Application Settings
APP_ENV=production          # Set to 'development' for debug output
APP_DEBUG=false             # NEVER set to true in production

# Security
CSRF_ENABLED=true           # CSRF token protection on forms

# File Upload Configuration
# Maximum file size in bytes (5MB = 5242880 bytes)
MAX_FILE_SIZE=5242880

# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp

# Storage Configuration
# Directory for uploaded files (outside web root for security)
UPLOAD_DIR=storage/uploads

# Logging
# Location of application logs
LOG_DIR=storage/logs

# ERROR HANDLING
# Show errors to users (false in production, true in development only)
SHOW_ERRORS=false
