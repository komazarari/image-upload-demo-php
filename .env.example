# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCS_UPLOAD_BUCKET=image-upload-demo-upload
GCS_PUBLIC_BUCKET=image-upload-demo-public
PUBSUB_TOPIC=image-events
PUBSUB_SUBSCRIPTION=image-events-server

# Storage Backend Configuration
# Options: json (local files), firestore (production)
STORAGE_BACKEND=json
STORAGE_DIR=/var/www/html/storage/uploads

# GCS Service Configuration
# Set to true to use real GCS, false to use mock service for local dev
USE_REAL_GCS=false

# Firestore Configuration (used when STORAGE_BACKEND=firestore)
FIRESTORE_COLLECTION=upload_records

# Service Account Configuration
# Path to service account key file (optional, uses ADC if not set)
GCP_KEY_FILE=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
APP_ENV=development

# Image Validation Rules
MAX_FILE_SIZE=5242880
MAX_IMAGE_WIDTH=4000
MAX_IMAGE_HEIGHT=3000
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp

# Signed URL Configuration
SIGNED_URL_EXPIRY=3600

# Service Account (local development only)
# For Cloud Run, use Application Default Credentials instead
GOOGLE_APPLICATION_CREDENTIALS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
